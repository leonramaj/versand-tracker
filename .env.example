# Kopiere diese Datei nach .env und trage deine Schlüssel ein.
# Ohne Schlüssel funktioniert die App trotzdem: Anbieter-Erkennung, Links zur
# Sendungsverfolgung und Demo-Nummern (DEMO1 … DEMO9).

# Port und Adresse des Servers
PORT=3000
HOST=0.0.0.0

# DHL Paket, DHL Express, Deutsche Post – kostenlos: https://developer.dhl.com
# (App anlegen und die API „Shipment Tracking - Unified“ auswählen)
DHL_API_KEY=

# Alle anderen Paketdienste weltweit – mindestens einen der beiden Aggregatoren eintragen:
# Ship24 (1.500+ Paketdienste): https://www.ship24.com
SHIP24_API_KEY=
# Tarif bei Ship24: per-shipment (Standard) oder per-call
SHIP24_PLAN=per-shipment

# 17TRACK (3.000+ Paketdienste): https://api.17track.net
TRACK17_API_KEY=

# Sprache der Statusmeldungen (sofern vom Anbieter unterstützt)
TRACKING_LANGUAGE=de

# Wie lange Ergebnisse zwischengespeichert werden (Sekunden) – schont API-Kontingente
CACHE_TTL_SECONDS=600

# Max. Tracking-Abfragen pro IP und Minute (0 = unbegrenzt)
RATE_LIMIT_PER_MINUTE=60

# Hinter einem Reverse-Proxy (nginx, Caddy …) auf true setzen, damit X-Forwarded-For gilt
TRUST_PROXY=false

# Demo-Nummern DEMO1 … DEMO9 deaktivieren
DEMO_MODE=true
